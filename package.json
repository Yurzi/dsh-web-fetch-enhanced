{
  "name": "dsh-web-fetch-enhanced",
  "version": "0.1.0",
  "description": "DeepSeek Harness web_fetch with operator-approved non-public destinations (fake-IP proxies, intranet docs) and a provider architecture for future fetch backends",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.cjs",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "examples",
    "docs",
    "CHANGELOG.md",
    "README.en.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "web-fetch",
    "ssrf",
    "fake-ip",
    "allowlist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yurzi/dsh-web-fetch-enhanced.git"
  },
  "homepage": "https://github.com/Yurzi/dsh-web-fetch-enhanced#readme",
  "bugs": {
    "url": "https://github.com/Yurzi/dsh-web-fetch-enhanced/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test && publint",
    "prepack": "pnpm run check",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web-fetch-http": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.13",
    "@types/react": "~18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "js-yaml": "^4.1.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "^1.61.1",
    "publint": "^0.3.21",
    "react": "^18.2.0",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
